#!/usr/bin/env bash
set -euo pipefail

kind="${1:-image}"
wallpaper_path="${2:-}"
outputs="${3:-all}"
transition="${4:-any}"
backend="${5:-awww}"
[[ "$backend" == "awww" || "$backend" == "swww" ]] || exit 2
transition_angle=45
case "$transition" in
    swipe) transition=left ;;
    diagonal) transition=wipe ;;
    any|fade|grow|wave|left|right|top|bottom|wipe|none|simple|center|outer|random) ;;
    *) transition=fade ;;
esac
runtime_root="${XDG_RUNTIME_DIR:-/tmp}/tonantzintla"
pid_file="$runtime_root/mpvpaper.pids"
mkdir -p "$runtime_root"

stop_tonantzintla_video() {
    if [[ -f "$pid_file" ]]; then
        while IFS= read -r process_id; do
            [[ "$process_id" =~ ^[0-9]+$ ]] && kill "$process_id" 2>/dev/null || true
        done < "$pid_file"
        : > "$pid_file"
    fi
}

[[ -f "$wallpaper_path" ]] || exit 2
stop_tonantzintla_video

if [[ "$kind" == "video" ]]; then
    if [[ "$outputs" == "all" || -z "$outputs" ]]; then
        targets=("*")
    else
        IFS=',' read -r -a targets <<< "$outputs"
    fi
    for output_name in "${targets[@]}"; do
        nohup mpvpaper -p -o "loop no-audio hwdec=auto profile=high-quality" \
            "$output_name" "$wallpaper_path" >/tmp/tonantzintla-mpvpaper.log 2>&1 &
        printf '%s\n' "$!" >> "$pid_file"
    done
    exit 0
fi

if [[ "$backend" == "awww" ]]; then
    awww query >/dev/null 2>&1 || {
        nohup awww-daemon -q >/tmp/tonantzintla-awww.log 2>&1 &
        sleep 0.35
    }
fi

command=("$backend" img "$wallpaper_path" --transition-type "$transition" --transition-angle "$transition_angle" --transition-pos 0.5,0.5 --transition-fps 120 --transition-duration 0.85)
if [[ "$outputs" != "all" && -n "$outputs" ]]; then
    command+=(--outputs "$outputs")
fi
"${command[@]}"

