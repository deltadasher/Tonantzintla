#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/../.." && pwd)"
theme_source="$project_root/src/quickshell/modules/umbra/greeter"
theme_name="tonantzintla-umbra"
theme_target="/usr/share/sddm/themes/$theme_name"
config_target="/etc/sddm.conf.d/30-tonantzintla-umbra.conf"
command_name="${1:-help}"

usage() {
    cat <<'EOF'
Usage: umbra-greeter COMMAND

  preview       Open the greeter in SDDM test mode without installing it
  stage DIR     Materialize a complete theme tree for validation
  install       Install/update the theme without selecting it
  activate      Install and make Umbra the active SDDM theme
  deactivate    Remove only Tonantzintla's SDDM selection override
  status        Show the installed and selected greeter state
EOF
}

stage_theme() {
    local destination="$1"
    local source_file relative_path
    install -d -- "$destination"
    while IFS= read -r -d '' source_file; do
        relative_path="${source_file#"$theme_source"/}"
        install -Dm 0644 -- "$source_file" "$destination/$relative_path"
    done < <(find "$theme_source" -maxdepth 1 -type f \
        \( -name '*.qml' -o -name '*.js' -o -name '*.png' \
        -o -name '*.webp' -o -name '*.jpg' -o -name '*.svg' \
        -o -name 'metadata.desktop' \) -print0)
    install -d -- "$destination/identity" "$destination/marks"
    install -m 0644 "$project_root/src/quickshell/components/identity/"*.qml "$project_root/src/quickshell/components/identity/"*.js "$destination/identity/"
    install -m 0644 "$project_root/src/quickshell/assets/theme-marks/"*.svg "$destination/marks/"
    sed -i 's#import "../../../components/identity"#import "identity"#' "$destination/Main.qml"
    python3 "$script_dir/umbra-greeter-palette.py" \
        --output "$destination/theme.conf"
}

install_theme() {
    local staging source_file
    staging="$(mktemp -d "${TMPDIR:-/tmp}/tonantzintla-umbra-install.XXXXXX")"
    trap 'rm -rf -- "${staging:-}"' RETURN
    stage_theme "$staging"
    sudo install -d -- "$theme_target"
    while IFS= read -r -d '' source_file; do
        sudo install -Dm 0644 -- "$source_file" "$theme_target/${source_file#"$staging"/}"
    done < <(find "$staging" -type f -print0)
}

case "$command_name" in
    preview)
        staging="$(mktemp -d "${TMPDIR:-/tmp}/tonantzintla-umbra-preview.XXXXXX")"
        trap 'rm -rf -- "$staging"' EXIT
        stage_theme "$staging"
        if command -v sddm-greeter-qt6 >/dev/null 2>&1; then
            sddm-greeter-qt6 --test-mode --theme "$staging"
        else
            sddm-greeter --test-mode --theme "$staging"
        fi
        ;;
    stage)
        destination="${2:?Usage: umbra-greeter stage DIR}"
        stage_theme "$destination"
        ;;
    install)
        install_theme
        printf 'Installed %s without changing the active SDDM theme.\n' "$theme_target"
        ;;
    activate)
        install_theme
        sudo install -Dm 0644 "$theme_source/sddm.conf" "$config_target"
        printf 'Umbra will become the SDDM greeter on the next login screen.\n'
        ;;
    deactivate)
        sudo rm -f -- "$config_target"
        printf 'Removed Tonantzintla SDDM override; the previous theme can take precedence again.\n'
        ;;
    status)
        if [[ -f "$theme_target/Main.qml" ]]; then
            printf 'installed=yes\n'
        else
            printf 'installed=no\n'
        fi
        if [[ -f "$config_target" ]] \
                && grep -Fq 'Current=tonantzintla-umbra' "$config_target"; then
            printf 'active=yes\n'
        else
            printf 'active=no\n'
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown Umbra greeter command: %s\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
