#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/../.." && pwd)"

instance_output="$(qs -p "$project_root/src/quickshell" list 2>/dev/null || true)"
mapfile -t roots < <(awk '/Process ID:/ { print $3 }' <<<"$instance_output")

if (( ${#roots[@]} == 0 )); then
    printf 'Tonantzintla is not running.\n' >&2
    exit 1
fi

declare -A seen=()
pids=()

collect_tree() {
    local pid="$1"
    local children_file="/proc/$pid/task/$pid/children"
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/status" ]] || return 0
    [[ -z "${seen[$pid]:-}" ]] || return 0
    seen[$pid]=1
    pids+=("$pid")
    if [[ -r "$children_file" ]]; then
        local child
        for child in $(<"$children_file"); do
            collect_tree "$child"
        done
    fi
    return 0
}

for root_pid in "${roots[@]}"; do
    collect_tree "$root_pid"
done

if (( ${#pids[@]} == 0 )); then
    printf 'Tonantzintla is running, but its process namespace is not visible here. Run this command from the Niri session.\n' >&2
    exit 1
fi

printf 'Tonantzintla runtime profile\n'
printf 'Source: %s\n' "$project_root"
printf 'Processes: %s\n\n' "${#pids[@]}"
printf '%-7s %-7s %9s %9s %9s %9s %6s %-10s %s\n' \
    PID PPID RSS PSS PRIVATE SWAP CPU ELAPSED COMMAND

total_rss_kib=0
total_pss_kib=0
total_private_kib=0
total_swap_kib=0

for pid in "${pids[@]}"; do
    rollup="/proc/$pid/smaps_rollup"
    [[ -r "$rollup" ]] || continue

    read -r rss_kib pss_kib private_kib swap_kib < <(
        awk '
            /^Rss:/ { rss = $2 }
            /^Pss:/ { pss = $2 }
            /^Private_Clean:/ { private_clean = $2 }
            /^Private_Dirty:/ { private_dirty = $2 }
            /^SwapPss:/ { swap = $2 }
            /^Swap:/ && !swap { swap = $2 }
            END { print rss + 0, pss + 0, private_clean + private_dirty, swap + 0 }
        ' "$rollup"
    )

    read -r ppid cpu elapsed command < <(
        ps -o ppid=,%cpu=,etime=,comm= -p "$pid" | awk '{$1=$1; print}'
    )
    [[ -n "${ppid:-}" ]] || continue

    printf '%-7s %-7s %8.1fM %8.1fM %8.1fM %8.1fM %5s%% %-10s %s\n' \
        "$pid" "$ppid" \
        "$(awk -v value="$rss_kib" 'BEGIN { print value / 1024 }')" \
        "$(awk -v value="$pss_kib" 'BEGIN { print value / 1024 }')" \
        "$(awk -v value="$private_kib" 'BEGIN { print value / 1024 }')" \
        "$(awk -v value="$swap_kib" 'BEGIN { print value / 1024 }')" \
        "$cpu" "$elapsed" "$command"

    (( total_rss_kib += rss_kib )) || true
    (( total_pss_kib += pss_kib )) || true
    (( total_private_kib += private_kib )) || true
    (( total_swap_kib += swap_kib )) || true
done

printf '\nTotals: RSS %.1f MiB | PSS %.1f MiB | private %.1f MiB | swap %.1f MiB\n' \
    "$(awk -v value="$total_rss_kib" 'BEGIN { print value / 1024 }')" \
    "$(awk -v value="$total_pss_kib" 'BEGIN { print value / 1024 }')" \
    "$(awk -v value="$total_private_kib" 'BEGIN { print value / 1024 }')" \
    "$(awk -v value="$total_swap_kib" 'BEGIN { print value / 1024 }')"
printf 'PSS is the useful comparison: shared pages are divided among their users instead of counted once per process.\n'
printf 'Scope: Tonantzintla and its helper descendants; unrelated daemons such as wallpaper engines are excluded.\n'
