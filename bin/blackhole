#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
# Internal executables the shell and this CLI spawn. Never user commands.
libexec="$project_root/src/libexec"
shell_root="$project_root/src/quickshell"
installer="$project_root/bin/tonantzintla-installer"
command_name="${1:-help}"

usage() {
    cat <<'EOF'
Usage: blackhole COMMAND [ARGUMENTS]

Lifecycle:
  run                     Run Tonantzintla in the foreground
  start                   Start one detached Tonantzintla instance
  session-start           Start Tonantzintla with the Umbra session ingress
  session-environment     Import the Niri environment into D-Bus services
  audio-recover           Repair a silent or incorrectly routed speaker sink
  stop                    Stop Tonantzintla
  restart                 Stop and start Tonantzintla
  status                  Show matching Quickshell instances
  daemon ACTION           Session supervisor: status or logs

Surfaces:
  open TAB                Open an Ephemeris surface
  toggle TAB              Toggle an Ephemeris surface
  close                   Close Ephemeris
  bar-edit                Open the full-screen Bar Studio edit mode
  quick [telemetry]       Toggle the System page (legacy shortcut)
  lock                    Engage the secure Umbra session veil
  lock-status             Query actual lock acquisition (read-only)
  preview-lock            Preview Umbra without locking the session
  greeter ACTION [TARGET] Manage Umbra adapters for SDDM, LightDM, greetd, Ly, or GDM
  capture ACTION          Run region-copy, region-save, full-copy, or full-save
  notify SUMMARY [BODY]   Show an Tonantzintla-local notification
  terminal                Open the configured terminal, or a system default
  browser                 Open the configured browser, or the system default
  files [PATH]            Open the configured file manager at PATH, or home

Machine:
  install                 Install Tonantzintla transactionally
  sync                    Pull git changes, apply update, and restart desktop
  update                  Pull the source and update Tonantzintla
  uninstall               Remove Tonantzintla's links and runtime
  plan                    Show what an install would change, without changing it
  doctor                  Report required and optional machine integrations

Configuration:
  config get [KEY]        Read all or a specific setting from settings.json
  config set KEY VALUE    Update a configuration key (e.g., barPosition left, ephemerisStyle spotlight)
  config preset NAME      Apply a desktop theme preset (serpantinum, caelestia, solaris, cyberpunk, minimalist)

Inspection:
  profile                 Show Tonantzintla process, CPU, and resident-memory usage
  obarun-audit            Print a bounded, read-only Obarun/66 report
  version                 Print the Tonantzintla version
  path                    Print the active Tonantzintla source path
EOF
}

# The installer is the only thing that changes the machine. Prefer the built
# binary; fall back to cargo from a source checkout so a contributor without a
# release artifact still has one command surface.
run_installer() {
    local action="$1"; shift
    local subcommand
    case "$action" in
        install) subcommand="apply" ;;
        plan) subcommand="dry-run" ;;
        doctor) subcommand="report" ;;
        *) subcommand="$action" ;;
    esac

    if [[ -x "$installer" ]]; then
        "$installer" --source "$project_root" "$subcommand" "$@"
        return $?
    fi

    local release_bin="$project_root/install/target/release/tonantzintla-installer"
    if [[ -x "$release_bin" ]]; then
        "$release_bin" --source "$project_root" "$subcommand" "$@"
        return $?
    fi

    local debug_bin="$project_root/install/target/debug/tonantzintla-installer"
    if [[ -x "$debug_bin" ]]; then
        "$debug_bin" --source "$project_root" "$subcommand" "$@"
        return $?
    fi

    local manifest="$project_root/install/Cargo.toml"
    if [[ -f "$manifest" ]] && command -v cargo >/dev/null 2>&1; then
        cargo run --quiet --release --locked --manifest-path "$manifest" -- \
            --source "$project_root" "$subcommand" "$@"
        return $?
    fi

    printf 'Error: tonantzintla-installer binary not found and cargo is not installed.\n' >&2
    printf 'Run from a source checkout with rust installed, or install a release binary.\n' >&2
    printf 'On Arch Linux, install Rust with: sudo pacman -S rust\n' >&2
    return 1
}

show_profile() {
    exec "$libexec/tonantzintla-profile"
}

require_argument() {
    if [[ -z "${2:-}" ]]; then
        printf '%s requires an argument.\n' "$1" >&2
        usage >&2
        exit 2
    fi
}

settings_file="${TONANTZINTLA_SETTINGS:-${XDG_CONFIG_HOME:-${HOME:?}/.config}/tonantzintla/settings.json}"

setting_value() {
    local key="$1"
    python3 - "$settings_file" "$key" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle).get(sys.argv[2], "")
    if isinstance(value, str):
        print(value.strip())
except (OSError, ValueError, TypeError):
    pass
PY
}

run_setting() {
    local key="$1"
    local configured
    configured="$(setting_value "$key")"
    if [[ -n "$configured" ]]; then
        exec sh -lc "$configured"
    fi
    return 1
}

manage_config() {
    local action="${1:-get}"
    shift || true

    python3 - "$settings_file" "$action" "$@" <<'PY'
import json
import os
import sys

settings_path = sys.argv[1]
action = sys.argv[2] if len(sys.argv) > 2 else "get"
args = sys.argv[3:]

data = {}
if os.path.exists(settings_path):
    try:
        with open(settings_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"Warning: Failed to parse {settings_path}: {e}", file=sys.stderr)

def save_data(d):
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    with open(settings_path, "w", encoding="utf-8") as f:
        json.dump(d, f, indent=2)

if action == "get":
    if args:
        key = args[0]
        if key in data:
            val = data[key]
            if isinstance(val, (dict, list)):
                print(json.dumps(val, indent=2))
            elif isinstance(val, bool):
                print("true" if val else "false")
            else:
                print(val)
        else:
            print(f"Key '{key}' not set in {settings_path}", file=sys.stderr)
            sys.exit(1)
    else:
        print(json.dumps(data, indent=2))

elif action == "set":
    if len(args) < 2:
        print("Usage: blackhole config set <key> <value>", file=sys.stderr)
        sys.exit(2)
    key = args[0]
    val_raw = args[1]
    if val_raw.lower() == "true":
        val = True
    elif val_raw.lower() == "false":
        val = False
    elif val_raw.isdigit():
        val = int(val_raw)
    else:
        try:
            val = float(val_raw)
        except ValueError:
            try:
                val = json.loads(val_raw)
            except Exception:
                val = val_raw
    data[key] = val
    save_data(data)
    print(f"✓ Set {key} = {json.dumps(val)}")

elif action == "preset":
    if not args:
        print("Usage: blackhole config preset <serpantinum|caelestia|solaris|cyberpunk|minimalist>", file=sys.stderr)
        sys.exit(2)
    preset_name = args[0].lower()
    presets = {
        "serpantinum": {
            "accentName": "violet",
            "barPosition": "top",
            "barMode": "capsules",
            "barHeightProfile": "nominal",
            "ephemerisStyle": "deck",
            "motionSpeedProfile": "fluid",
            "typographyProfile": "serpantinum",
            "fontText": "JetBrains Mono",
            "fontDisplay": "JetBrains Mono",
            "fontMono": "JetBrains Mono"
        },
        "caelestia": {
            "accentName": "cyan",
            "barPosition": "left",
            "barMode": "capsules",
            "barHeightProfile": "compact",
            "ephemerisStyle": "spotlight",
            "motionSpeedProfile": "snappy",
            "typographyProfile": "readable",
            "fontText": "Noto Sans",
            "fontDisplay": "Noto Sans Display",
            "fontMono": "Noto Sans Mono"
        },
        "solaris": {
            "accentName": "amber",
            "barPosition": "bottom",
            "barMode": "docked",
            "barHeightProfile": "nominal",
            "ephemerisStyle": "spotlight",
            "motionSpeedProfile": "fluid",
            "clock12h": False
        },
        "cyberpunk": {
            "accentName": "rose",
            "barPosition": "right",
            "barMode": "capsules",
            "barHeightProfile": "compact",
            "ephemerisStyle": "spotlight",
            "motionSpeedProfile": "instant",
            "typographyProfile": "serpantinum",
            "fontText": "JetBrains Mono",
            "fontDisplay": "JetBrains Mono",
            "fontMono": "JetBrains Mono"
        },
        "minimalist": {
            "accentName": "silver",
            "barPosition": "top",
            "barMode": "floating",
            "barHeightProfile": "compact",
            "ephemerisStyle": "spotlight",
            "motionSpeedProfile": "snappy",
            "showSystemStats": False,
            "showNetworkLabel": False,
            "showBluetooth": False,
            "showBrightness": False,
            "showBattery": True,
            "showMicrophone": False,
            "showTray": False,
            "showDate": False
        }
    }
    if preset_name not in presets:
        print(f"Error: Unknown preset '{preset_name}'. Supported presets: {', '.join(sorted(presets.keys()))}", file=sys.stderr)
        sys.exit(1)
    
    preset = presets[preset_name]
    data.update(preset)
    save_data(data)
    print(f"✦ Wrote '{preset_name}' desktop preset to {settings_path}. (Run 'blackhole restart' to reload desktop)")
else:
    print(f"Unknown config action: {action}. Use: get, set, preset", file=sys.stderr)
    sys.exit(2)
PY
}

launch_terminal() {
    local cmd=("$@")
    local configured
    configured="$(setting_value terminal)"
    if [[ -n "$configured" ]]; then
        if [[ ${#cmd[@]} -gt 0 ]]; then
            exec sh -lc "$configured \"\$@\"" -- "${cmd[@]}"
        else
            exec sh -lc "$configured"
        fi
    fi
    if command -v xdg-terminal-exec >/dev/null 2>&1; then
        exec xdg-terminal-exec "${cmd[@]}"
    fi
    if [[ -n "${TERMINAL:-}" ]]; then
        if [[ ${#cmd[@]} -gt 0 ]]; then
            exec sh -lc "$TERMINAL \"\$@\"" -- "${cmd[@]}"
        else
            exec sh -lc "$TERMINAL"
        fi
    fi
    local candidate
    for candidate in foot kitty alacritty wezterm konsole gnome-terminal \
        xfce4-terminal terminology xterm; do
        if command -v "$candidate" >/dev/null 2>&1; then
            exec "$candidate" "${cmd[@]}"
        fi
    done
    printf 'No terminal is configured or discoverable. Set one in Tonantzintla Settings.\n' >&2
    exit 1
}

launch_files() {
    local target="${1:-$HOME}"
    local configured
    configured="$(setting_value fileManager)"
    if [[ -n "$configured" ]]; then
        exec sh -lc "$configured \"\$1\"" -- "$target"
    fi
    exec xdg-open "$target"
}

active_tonantzintla_instance() {
    qs list --all 2>/dev/null | awk '
        /^Instance [^:]+:$/ {
            instance = $2
            sub(/:$/, "", instance)
        }
        /^[[:space:]]+Config path: .*\/tonantzintla\/(src\/quickshell\/)?shell\.qml$/ {
            selected = instance
        }
        END {
            if (selected != "")
                print selected
        }
    '
}

call_ipc() {
    if qs -p "$shell_root" list 2>/dev/null | grep -q '^Instance '; then
        exec qs -p "$shell_root" ipc call "$@"
    fi

    local instance
    instance="$(active_tonantzintla_instance)"
    if [[ -n "$instance" ]]; then
        exec qs ipc -i "$instance" call "$@"
    fi

    printf 'Tonantzintla is not running. Start it with: %s/.local/bin/blackhole start\n' "$HOME" >&2
    exit 1
}

retire_legacy_session() {
    local old="${XDG_DATA_HOME:-$HOME/.local/share}/astralith"
    if [[ -f "$old/.astralith-install/source" ]]; then
        if [[ -f "$old/src/libexec/session-daemon.py" ]]; then
            python3 "$old/src/libexec/session-daemon.py" stop || return
        fi
        if [[ -f "$old/src/quickshell/shell.qml" ]]; then
            qs -p "$old/src/quickshell" kill >/dev/null 2>&1 || true
        elif [[ -f "$old/shell.qml" ]]; then
            qs -p "$old" kill >/dev/null 2>&1 || true
        fi
    fi
}

case "$command_name" in
    run)
        exec qs -p "$shell_root"
        ;;
    start)
        retire_legacy_session
        exec python3 "$libexec/session-daemon.py" start
        ;;
    session-start)
        retire_legacy_session
        export TONANTZINTLA_SESSION_INGRESS=1
        if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]]; then
            export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
        fi
        "$0" session-environment >/dev/null 2>&1 || true
        exec python3 "$libexec/session-daemon.py" start
        ;;
    session-environment)
        environment_names=(WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
            XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS DISPLAY)
        if command -v systemctl >/dev/null 2>&1 \
            && systemctl --user show-environment >/dev/null 2>&1; then
            exec dbus-update-activation-environment --systemd "${environment_names[@]}"
        fi
        exec dbus-update-activation-environment "${environment_names[@]}"
        ;;
    audio-recover)
        exec "$libexec/audio-recover"
        ;;
    stop)
        python3 "$libexec/session-daemon.py" stop
        qs -p "$shell_root" kill
        ;;
    restart)
        retire_legacy_session
        python3 "$libexec/session-daemon.py" stop
        qs -p "$shell_root" kill >/dev/null 2>&1 || true
        exec python3 "$libexec/session-daemon.py" start
        ;;
    daemon)
        case "${2:-status}" in
            status|logs) exec python3 "$libexec/session-daemon.py" "${2:-status}" ;;
            *) printf 'Usage: blackhole daemon [status|logs]\n' >&2; exit 2 ;;
        esac
        ;;
    status)
        exec qs -p "$shell_root" list
        ;;
    open)
        require_argument "$command_name" "${2:-}"
        if [[ -n "${3:-}" ]]; then
            call_ipc ephemeris openSection "$2" "$3"
        else
            call_ipc ephemeris open "$2"
        fi
        ;;
    toggle)
        require_argument "$command_name" "${2:-}"
        call_ipc ephemeris toggle "$2"
        ;;
    close)
        call_ipc ephemeris close
        ;;
    bar-edit)
        call_ipc aperture edit
        ;;
    island-settings)
        target="${2:-clock}"
        call_ipc aperture openIsland "$target"
        ;;
    close-island)
        call_ipc aperture closeIsland
        ;;
    quick)
        tab="${2:-telemetry}"
        # Keep existing user keybindings working after Chronos removal.
        [[ "$tab" == "timer" ]] && tab="telemetry"
        if [[ "$tab" != "telemetry" ]]; then
            printf 'Unknown quick-action: %s\n' "$tab" >&2
            exit 2
        fi
        call_ipc quickactions toggle "$tab"
        ;;
    lock)
        exec qs -d -n -p "$shell_root/umbra-lock.qml"
        ;;
    lock-status)
        exec qs -p "$shell_root/umbra-lock.qml" ipc call lockState status
        ;;
    preview-lock)
        call_ipc umbra preview
        ;;
    greeter)
        action="${2:-help}"
        exec "$libexec/umbra-greeter-portable" "$action" "${3:-auto}"
        ;;
    reveal-lock)
        call_ipc umbra reveal
        ;;
    capture)
        require_argument "$command_name" "${2:-}"
        case "$2" in
            region-copy|region-save|full-copy|full-save)
                exec "$libexec/snipping-tool" "--$2"
                ;;
            *)
                printf 'Unknown capture action: %s\n' "$2" >&2
                exit 2
                ;;
        esac
        ;;
    notify)
        require_argument "$command_name" "${2:-}"
        exec "$libexec/tonantzintla-notify" "$2" "${3:-}"
        ;;
    terminal)
        launch_terminal "${@:2}"
        ;;
    browser)
        run_setting browser || exec xdg-open "about:blank"
        ;;
    files)
        launch_files "${2:-$HOME}"
        ;;
    config)
        manage_config "${@:2}"
        ;;
    sync)
        printf '✦ Syncing Tonantzintla observatory...\n'
        if [[ -e "$project_root/.git" ]]; then
            source_status="$(git -C "$project_root" status --porcelain)"
            if [[ -n "$source_status" ]]; then
                printf 'Source has local changes. Commit them before syncing, or use blackhole install to install local work.\n' >&2
                exit 1
            fi
            printf '→ Updating source repository from git...\n'
            if git -C "$project_root" pull --ff-only; then
                pull_status=0
            else
                pull_status=$?
                printf 'Error: git pull failed. Sync halted to prevent overwriting local state.\n' >&2
                exit "$pull_status"
            fi
        fi
        printf '→ Applying runtime update...\n'
        if (run_installer apply --profile recommended --niri keep --umbra lock --yes); then
            install_status=0
        else
            install_status=$?
            printf 'Error: Runtime installation failed. Desktop restart skipped.\n' >&2
            exit "$install_status"
        fi
        printf '→ Restarting running desktop instance...\n'
        exec "$project_root/bin/blackhole" restart
        ;;
    install|update|uninstall|doctor|plan)
        run_installer "$@"
        ;;
    profile)
        show_profile
        ;;
    obarun-audit)
        exec "$libexec/obarun-audit" "${@:2}"
        ;;
    version)
        cat "$project_root/VERSION"
        if [[ -f "$project_root/.tonantzintla-install/revision" ]]; then
            printf 'Installed commit: %s\n' "$(<"$project_root/.tonantzintla-install/revision")"
            printf 'Installed at: %s\n' "$project_root"
            python3 "$libexec/build-status.py"
        elif [[ -d "$project_root/.git" ]]; then
            git -C "$project_root" log -1 --format='Checkout commit: %h'
        fi
        ;;
    path)
        printf '%s\n' "$project_root"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown Tonantzintla command: %s\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
